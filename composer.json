{
    "name": "madbox-99/laravel-google-connect",
    "description": "Unified Google OAuth (Ads + Search Console + Analytics) connection for multi-tenant Laravel + Filament apps.",
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "Zoltán Tamás Szabó", "email": "zoli.szabok@gmail.com" }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/database": "^13.0",
        "filament/filament": "^5.0",
        "livewire/livewire": "^4.0",
        "google/apiclient": "^2.18",
        "googleads/google-ads-php": "^33.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": { "MadBox\\GoogleConnect\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MadBox\\GoogleConnect\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["MadBox\\GoogleConnect\\GoogleConnectServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "scripts": {
        "test": "pest"
    }
}
